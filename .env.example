# ===========================================
# TraceGuard — environment configuration
# Copy this file to .env and fill in values.
# Never commit the real .env file.
# ===========================================

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Demo mode ---
# When true, the scan engine returns clearly-labelled simulated
# data instead of calling real third-party APIs. Useful for local
# development when you don't yet have API keys.
DEMO_MODE=true

# --- Breach data provider (Have I Been Pwned) ---
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Optional public web search provider (for Public Exposure checks) ---
# Any search API that returns publicly indexed pages is fine
# (e.g. Bing Web Search, SerpAPI). Leave blank to skip this scanner.
SEARCH_API_KEY=
SEARCH_API_URL=

# --- Optional disposable-email-detection API ---
DISPOSABLE_EMAIL_API_KEY=

# --- Database (optional — only needed if you enable persistent storage) ---
DATABASE_URL=

# --- Security ---
# Long random string used if/when auth tokens are introduced.
JWT_SECRET=change_this_to_a_long_random_string

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_SCANS_PER_IP=5
